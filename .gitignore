# Generated / working files
work/*
!work/.gitkeep
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep
input/*
!input/.gitkeep

# Sample material and caches created during testing
input/SAMPLE CASE/
# The bank's real seal is confidential and machine-specific: never committed.
# assets/stamp_PLACEHOLDER.png IS committed, so a fresh clone still runs.
assets/stamp.png
__pycache__/
*.pyc
*.pyo

# Per-machine settings (case name, recent folders, window position). Ship
# config.example.json instead and let Config fall back to its built-in defaults.
config.json

# The finished portable package. It is ~100 MB and is built on demand with
# tools/build_release.ps1 - it must never be committed, and it must never be the
# way anyone gets a fix.  Ship the zip, not the folder.
release/

# Scratch scripts used while debugging or screenshotting - not part of the
# product. Anything in tools/ starting with "_" is one of these. (The real test
# and build scripts do not use that prefix.)
tools/_*.py
